# Frontend (Vite) — Supabase Auth
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_CLAVE

# Backend (Vercel Functions) — Supabase admin
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_TU_CLAVE

# Backend (Vercel Functions) — Meta / Instagram Unified Login
META_APP_ID=TU_APP_ID
META_APP_SECRET=TU_APP_SECRET
META_CONFIG_ID=TU_CONFIG_ID_DE_INSTAGRAM_UNIFIED_LOGIN

# Genera una clave aleatoria de 32 bytes y codifícala en base64.
# Ejemplo: openssl rand -base64 32
TOKEN_ENC_KEY=TU_CLAVE_BASE64_DE_32_BYTES

# URL pública de esta app, sin barra final
SITE_URL=https://TU-DOMINIO

# Opcional: Vercel cron usa CRON_SECRET automáticamente como Bearer.
CRON_SECRET=TU_SECRETO_ALEATORIO

# Opcional: fija la versión de Graph API (por defecto v27.0)
# IG_API_VERSION=v27.0
